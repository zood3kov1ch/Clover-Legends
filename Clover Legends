-- main farm loop
local lastSkillTime = 0

task.spawn(function()
    while true do
        local now = tick()
        local char = LocalPlayer.Character
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")

        if Toggles.AutoFarm.Value or Toggles.AutoSkill.Value then
            local enemy = getNearestTarget()

            if enemy and rootPart then
                local enemyRoot = enemy.HumanoidRootPart

                if Toggles.AutoFarm.Value then
                tweenTo(enemyRoot)

                BasicAttack:FireServer(
                enemyRoot.CFrame,
                nil,
                enemyRoot.Position,
                1
                )
                StatusLabel:SetText("Status: M1 on " .. enemy.Name)
                end
                
                if Toggles.AutoSkill.Value and now - lastSkillTime >= Options.SkillCooldown.Value then
                    local selectedSkills = getSelectedSkills()
                    
                    for _, skillName in ipairs(selectedSkills) do
                        CastSkill:FireServer(
                            skillName,
                            rootPart.CFrame,
                            enemyRoot.Position
                        )
                    end
                    
                    lastSkillTime = now
                    
                    if #selectedSkills > 0 then
                        StatusLabel:SetText("Status: Casting " .. table.concat(selectedSkills, ", "))
                    end
                end
            else
                StatusLabel:SetText("Status: No targets found")
            end
        else
            StatusLabel:SetText("Status: Idle")
            if currentTween then
                currentTween:Cancel()
            end
        end
        task.wait(0.1)
    end
end)

