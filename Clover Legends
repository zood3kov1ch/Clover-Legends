-- refresh enemies list
local function refreshEnemiesList()
    local hasNew = false
    for _, enemy in pairs(EnemiesFolder:GetChildren()) do
        if enemy:IsA("Model") and not knownEnemies[enemy.Name] then
            knownEnemies[enemy.Name] = true
            hasNew = true
        end
    end
    if hasNew then
        local currentSelections = {}
        local val = Options.TargetEnemies.Value
        if type(val) == "table" then
            for k, v in pairs(val) do
                if v then currentSelections[k] = true end
            end
        end
        Options.TargetEnemies:SetValues(getUniqueEnemyNames())
        if next(currentSelections) then
            Options.TargetEnemies:SetValue(currentSelections)
        end
    end
    return hasNew
end

