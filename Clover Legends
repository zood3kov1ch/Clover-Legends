-- detect player's current grimoire
local function detectPlayerGrimoire()
    local grimoireName = nil

    local playerStats = LocalPlayer:FindFirstChild("PlayerStats") or LocalPlayer:FindFirstChild("leaderstats")
    if playerStats then
        local val = playerStats:FindFirstChild("Grimoire") or playerStats:FindFirstChild("EquippedGrimoire") or playerStats:FindFirstChild("CurrentGrimoire")
        if val then grimoireName = tostring(val.Value) end
    end

    local char = LocalPlayer.Character
    if char and not grimoireName then
        local val = char:FindFirstChild("Grimoire") or char:FindFirstChild("EquippedGrimoire")
        if val then grimoireName = tostring(val.Value) end
    end

    if not grimoireName then
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            for _, item in pairs(backpack:GetChildren()) do
                if item:IsA("Tool") then
                    for gType, _ in pairs(grimoireSkills) do
                        if item.Name:lower():find(gType:lower()) then
                            grimoireName = gType
                            break
                        end
                    end
                    if grimoireName then break end
                end
            end
        end
    end

    if not grimoireName and char then
        for _, item in pairs(char:GetChildren()) do
            if item:IsA("Tool") then
                for gType, _ in pairs(grimoireSkills) do
                    if item.Name:lower():find(gType:lower()) then
                        grimoireName = gType
                        break
                    end
                end
                if grimoireName then break end
            end
        end
    end

    return grimoireName
end

local function getPlayerSkills()
    local grimoire = detectPlayerGrimoire()
    if grimoire and grimoireSkills[grimoire] then
        return grimoireSkills[grimoire], grimoire
    end
    local allSkills = {}
    for _, skills in pairs(grimoireSkills) do
        for _, skill in ipairs(skills) do
            table.insert(allSkills, skill)
        end
    end
    return allSkills, "Unknown"
end

