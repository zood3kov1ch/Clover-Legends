local function getNearestTarget()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end

    local myPos = char.HumanoidRootPart.Position
    local nearest = nil
    local minDist = math.huge
    local selectedNames = getSelectedEnemies()

    for _, enemy in pairs(EnemiesFolder:GetChildren()) do
        if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") then
            local hum = enemy.Humanoid
            if hum.Health > 0 then
                local isTarget = (#selectedNames == 0)
                if not isTarget then
                    for _, name in ipairs(selectedNames) do
                        if enemy.Name == name then
                            isTarget = true
                            break
                        end
                    end
                end
                if isTarget then
                    local dist = (enemy.HumanoidRootPart.Position - myPos).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = enemy
                    end
                end
            end
        end
    end

    return nearest
end

local currentTween = nil

local function getFarmCFrame(enemyRoot)
    local pos = Options.FarmPosition.Value
    local height = Options.FarmHeight.Value
    local enemyPos = enemyRoot.Position

    if pos == "Above" then
        return CFrame.new(enemyPos + Vector3.new(0, height, 0))
    elseif pos == "Below" then
        return CFrame.new(enemyPos + Vector3.new(0, -height, 0))
    elseif pos == "Behind" then
        local behindOffset = enemyRoot.CFrame.LookVector * -8
        return CFrame.new(enemyPos + behindOffset + Vector3.new(0, height, 0))
    end

    return CFrame.new(enemyPos + Vector3.new(0, height, 0))
end

local function tweenTo(enemyRoot)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    if currentTween then
        currentTween:Cancel()
    end

    local speed = Options.TweenSpeed.Value
    local tweenInfo = TweenInfo.new(speed, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local goalCFrame = getFarmCFrame(enemyRoot)
    local goal = { CFrame = goalCFrame }

    currentTween = TweenService:Create(char.HumanoidRootPart, tweenInfo, goal)
    currentTween:Play()
end

